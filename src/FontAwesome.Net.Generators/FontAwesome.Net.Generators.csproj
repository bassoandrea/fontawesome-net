<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<TargetFramework>netstandard2.0</TargetFramework>
		<LangVersion>latest</LangVersion>
		<OutputItemType>Analyzer</OutputItemType>
		<EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
	</PropertyGroup>

	<PropertyGroup>
		<Version>1.0.0</Version>
		<Authors>bassoandrea</Authors>
		<Description>A Roslyn source generator that creates strongly-typed C# icon classes (FontAwesomeIcon) and style classes (FontAwesomeIconStyle) from Font Awesome icons.json metadata. Enables compile-time icon generation with IntelliSense support, type safety, and seamless integration with WPF controls.</Description>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<PackageLicenseExpression>MIT</PackageLicenseExpression>
		<RepositoryUrl>https://github.com/bassoandrea/fontawesome-net</RepositoryUrl>
		<Copyright>Copyright (c) 2026 bassoandrea</Copyright>
	</PropertyGroup>

	<ItemGroup>
		<None Include="..\..\README.md" Pack="true" PackagePath="\" Visible="false" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.CodeAnalysis.Analyzers" Version="3.11.0" PrivateAssets="all" />
		<PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.13.0" />
		<PackageReference Include="System.Text.Json" Version="10.0.3" PrivateAssets="all" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\FontAwesome.Net\FontAwesome.Net.csproj" PrivateAssets="all" />
	</ItemGroup>

	<Target Name="AddAnalyzerToPackage" AfterTargets="Build">
		<ItemGroup>
			<None Include="$(OutputPath)$(AssemblyName).dll" Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false" />
			<None Include="..\FontAwesome.Net\bin\$(Configuration)\netstandard2.0\FontAwesome.Net.dll" Pack="true" PackagePath="lib/netstandard2.0" Visible="false" />
		</ItemGroup>
	</Target>
</Project>