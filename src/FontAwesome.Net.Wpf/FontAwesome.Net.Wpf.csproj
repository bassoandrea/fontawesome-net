<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net48; net5.0-windows</TargetFrameworks>
	<UseWPF>true</UseWPF>
  </PropertyGroup>

	<PropertyGroup>
		<Version>1.0.0</Version>
		<Authors>bassoandrea</Authors>
		<Description>WPF controls for Font Awesome icons with built-in spin animations, rotation, and flip support. Includes FontAwesomeImage (vector-based) and FontAwesomeBlock (text-based) controls with MVVM-friendly dependency properties for data binding. Supports .NET Framework 4.8+ and .NET 5+.</Description>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<PackageLicenseExpression>MIT</PackageLicenseExpression>
		<RepositoryUrl>https://github.com/bassoandrea/fontawesome-net</RepositoryUrl>
		<Copyright>Copyright (c) 2026 bassoandrea</Copyright>
	</PropertyGroup>

	<ItemGroup>
		<None Include="$(SolutionDir)README.md" Pack="true" PackagePath="\" Visible="false" />
	</ItemGroup>

  <ItemGroup>
    <PackageReference Include="FontAwesome.Net.Generators" Version="1.0.0" />
  </ItemGroup>

</Project>
