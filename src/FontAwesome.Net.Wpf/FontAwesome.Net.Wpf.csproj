<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net48; net5.0-windows</TargetFrameworks>
	<UseWPF>true</UseWPF>
  </PropertyGroup>

	<PropertyGroup>
		<Version>1.0.0</Version>
		<Authors>bassoandrea</Authors>
		<Description>
			FontAwesome.Net.Wpf provides WPF controls and helpers for using Font Awesome icons in .NET applications. 
			Includes a `FontAwesomeImage` control, supports generated icon enums, data binding, and scalable vector rendering for easy integration with .NET Framework and .NET 5 WPF projects.
		</Description>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<PackageLicenseExpression>MIT</PackageLicenseExpression>
		<RepositoryUrl>https://github.com/bassoandrea/fontawesome-net</RepositoryUrl>
		<Copyright>Copyright (c) 2026 bassoandrea</Copyright>
	</PropertyGroup>

	<ItemGroup>
		<None Include="$(SolutionDir)README.md" Pack="true" PackagePath="\" Visible="false" />
	</ItemGroup>

  <ItemGroup>
    <PackageReference Include="FontAwesome.Net.Generators" Version="1.0.0" />
  </ItemGroup>

</Project>
